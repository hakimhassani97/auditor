# Copy to .env; blank keeps offline demo mode available.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_API_BASE_URL=https://api.meta.ai/v1
ENABLE_EXTERNAL_PROCESSING=false
DATA_DIR=./data
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25
# Requires both ENABLE_EXTERNAL_PROCESSING=true and an explicit confirmed-finding research action.
ENABLE_WEB_SEARCH=false
